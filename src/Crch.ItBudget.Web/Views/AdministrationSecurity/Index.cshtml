@model Crch.ItBudget.Web.Models.Administration.SecurityMappingsViewModel
@{
    ViewData["Title"] = "Security Administration";
}

<section class="card" aria-labelledby="security-title">
    <h1 id="security-title">Security administration</h1>
    <p>Map logical IT Budget roles to Active Directory security groups and manage explicit per-user grant/deny exceptions. Deployment-config mappings remain available for bootstrap/recovery.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div role="alert" style="border:1px solid #b42318;background:#fff1f0;padding:.75rem;margin:1rem 0;border-radius:.35rem">
            @Model.ErrorMessage
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div role="status" style="border:1px solid #067647;background:#ecfdf3;padding:.75rem;margin:1rem 0;border-radius:.35rem">
            @Model.SuccessMessage
        </div>
    }

    <h2>Add or reactivate an AD mapping</h2>
    <form method="post" action="/admin/security/ad-groups">
        @Html.AntiForgeryToken()
        <div style="display:grid;grid-template-columns:1fr 2fr;gap:1rem;max-width:800px">
            <div>
                <label for="role"><strong>Application role</strong></label><br />
                <select id="role" name="role" required>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            <div>
                <label for="groupName"><strong>AD group</strong></label><br />
                <input id="groupName" name="groupName" maxlength="256" required style="width:100%" autocomplete="off" />
            </div>
            <div style="grid-column:1 / -1">
                <label for="description">Description</label><br />
                <input id="description" name="description" maxlength="1000" style="width:100%" />
            </div>
        </div>
        <p><button type="submit">Save mapping</button></p>
    </form>
</section>

<section class="card" aria-labelledby="mapping-list-title" style="margin-top:1rem">
    <h2 id="mapping-list-title">Database-backed AD mappings</h2>
    @if (Model.Mappings.Count == 0)
    {
        <p class="muted">No database mappings have been configured yet. Bootstrap configuration may still grant access.</p>
    }
    else
    {
        <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse">
                <thead>
                    <tr>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">Role</th>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">AD group</th>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">Description</th>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">State</th>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mapping in Model.Mappings)
                    {
                        <tr>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2">@mapping.Role</td>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2"><code>@mapping.GroupName</code></td>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2">@mapping.Description</td>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2">@(mapping.IsActive ? "Active" : "Inactive")</td>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2">
                                <form method="post" action="/admin/security/ad-groups/@mapping.Id/state">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="isActive" value="@(!mapping.IsActive)" />
                                    <button type="submit">@(mapping.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card" aria-labelledby="exception-title" style="margin-top:1rem">
    <h2 id="exception-title">Per-user role exceptions</h2>
    <p class="muted">Use exceptions sparingly. An active <strong>Deny</strong> overrides both a user grant and AD group membership for that role.</p>

    <form method="post" action="/admin/security/user-exceptions">
        @Html.AntiForgeryToken()
        <div style="display:grid;grid-template-columns:2fr 1fr 1fr;gap:1rem;max-width:900px">
            <div>
                <label for="domainIdentity"><strong>Domain username</strong></label><br />
                <input id="domainIdentity" name="domainIdentity" maxlength="256" placeholder="DOMAIN\username" required style="width:100%" autocomplete="off" />
            </div>
            <div>
                <label for="exceptionRole"><strong>Role</strong></label><br />
                <select id="exceptionRole" name="role" required>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            <div>
                <label for="effect"><strong>Effect</strong></label><br />
                <select id="effect" name="effect" required>
                    @foreach (var effect in Model.Effects)
                    {
                        <option value="@effect">@effect</option>
                    }
                </select>
            </div>
            <div style="grid-column:1 / -1">
                <label for="reason"><strong>Reason</strong></label><br />
                <input id="reason" name="reason" maxlength="2000" required style="width:100%" />
            </div>
        </div>
        <p><button type="submit">Save user exception</button></p>
    </form>

    @if (Model.UserExceptions.Count == 0)
    {
        <p class="muted">No user-specific role exceptions have been configured.</p>
    }
    else
    {
        <div style="overflow-x:auto">
            <table style="width:100%;border-collapse:collapse">
                <thead>
                    <tr>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">User</th>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">Role</th>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">Effect</th>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">Reason</th>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">State</th>
                        <th scope="col" style="text-align:left;padding:.5rem;border-bottom:1px solid #dfe3e8">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exception in Model.UserExceptions)
                    {
                        <tr>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2"><code>@exception.DomainIdentity</code></td>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2">@exception.Role</td>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2">@exception.Effect</td>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2">@exception.Reason</td>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2">@(exception.IsActive ? "Active" : "Inactive")</td>
                            <td style="padding:.5rem;border-bottom:1px solid #eef0f2">
                                @if (exception.IsActive)
                                {
                                    <form method="post" action="/admin/security/user-exceptions/@exception.Id/deactivate">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Deactivate</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
