@model Crch.ItBudget.Web.Models.Imports.ImportPreviewViewModel
@{
    ViewData["Title"] = "Imports & Exports";
}

<section class="card" aria-labelledby="import-title">
    <h1 id="import-title">FY2027 workbook migration preview</h1>
    <p>Upload one of the verified CRCH FY2027 Excel workbooks. The application validates the workbook structure, recalculates planned totals from quantity × unit cost, resolves managed lookup values, and stores a preview before any budget records are committed.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div role="alert" style="border:1px solid #b42318;background:#fff1f0;padding:.75rem;margin:1rem 0;border-radius:.35rem">
            <strong>Upload could not be previewed.</strong><br />@Model.ErrorMessage
        </div>
    }

    <form method="post" action="/imports/fy2027/preview" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div style="margin:1rem 0">
            <label for="workbook"><strong>FY2027 Excel workbook</strong></label><br />
            <input id="workbook" name="workbook" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
        </div>
        <button type="submit">Generate migration preview</button>
    </form>
</section>

@if (Model.Result is not null)
{
    <section class="card" aria-labelledby="preview-title" style="margin-top:1rem">
        <h2 id="preview-title">Preview result</h2>
        <dl>
            <dt>Import batch</dt><dd><code>@Model.Result.ImportBatchId</code></dd>
            <dt>Status</dt><dd>@Model.Result.Status</dd>
            <dt>Source rows</dt><dd>@Model.Result.SourceRowCount</dd>
            <dt>Accepted rows</dt><dd>@Model.Result.AcceptedRowCount</dd>
            <dt>Rejected rows</dt><dd>@Model.Result.RejectedRowCount</dd>
            <dt>Warnings</dt><dd>@Model.Result.WarningCount</dd>
            <dt>Errors</dt><dd>@Model.Result.ErrorCount</dd>
            <dt>FY2027 reconciliation</dt><dd>@(Model.Result.ReconciledToExpectedTargets ? "Matches expected targets" : "Requires review")</dd>
        </dl>
        <p class="muted">This action creates preview/audit records only. It does not write FY2027 budget items to the authoritative budget tables.</p>
    </section>
}
