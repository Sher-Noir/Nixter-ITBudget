@model LedgerForge.Web.Models.Budgeting.BudgetPlanningViewModel
@using LedgerForge.Domain.Budgeting
@using LedgerForge.Infrastructure.Budgeting
@{
    ViewData["Title"] = "Budget";
    var snapshot = Model.Snapshot;
    var actualError = TempData["ActualsError"] as string;
    var actualSuccess = TempData["ActualsSuccess"] as string;
    var canManageImports = ViewData["CanManageImports"] as bool? == true;
    var canPostActuals = ViewData["CanPostActuals"] as bool? == true;
    var createOptions = ViewData["CreateOptions"] as LedgerForge.Infrastructure.Budgeting.BudgetItemCreateOptions;
    var sectionFilter = Context.Request.Query["section"].ToString();
    var categoryFilter = Context.Request.Query["category"].ToString();
    var locationFilter = Context.Request.Query["location"].ToString();
    var vendorFilter = Context.Request.Query["vendor"].ToString();
    var needFilter = Context.Request.Query["need"].ToString();
    var statusFilter = Context.Request.Query["status"].ToString();
    var searchFilter = Context.Request.Query["q"].ToString();

    var filteredItems = snapshot.Items
        .Where(x => string.IsNullOrWhiteSpace(sectionFilter) || string.Equals(x.BudgetSectionName, sectionFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(categoryFilter) || string.Equals(x.InternalCategoryName, categoryFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(locationFilter) || string.Equals(x.LocationName, locationFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(vendorFilter) || string.Equals(x.VendorName, vendorFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(needFilter) || string.Equals(x.NeedLevelName, needFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(statusFilter) || string.Equals(x.Status.ToString(), statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(x => string.IsNullOrWhiteSpace(searchFilter) ||
            x.ItemNumber.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ||
            x.Description.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ||
            (x.ReasonPurpose?.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ?? false))
        .ToArray();

    var requestedPage = int.TryParse(Context.Request.Query["page"].ToString(), out var parsedPage) ? parsedPage : 1;
    var requestedSize = int.TryParse(Context.Request.Query["pageSize"].ToString(), out var parsedSize) ? parsedSize : BudgetItemTable.DefaultPageSize;
    var table = BudgetItemTable.Create(
        filteredItems,
        Context.Request.Query["sort"].ToString(),
        Context.Request.Query["dir"].ToString(),
        requestedPage,
        requestedSize);
    var firstPageLink = Math.Max(1, table.PageNumber - 2);
    var lastPageLink = Math.Min(table.TotalPages, firstPageLink + 4);
    firstPageLink = Math.Max(1, lastPageLink - 4);

    string TableUrl(int page, string? sort = null, string? direction = null, int? pageSize = null, Guid? itemId = null)
        => Url.Action("Index", "Budget", new
        {
            fiscalYearId = snapshot.SelectedFiscalYearId,
            versionId = snapshot.SelectedVersionId,
            section = sectionFilter, category = categoryFilter, location = locationFilter,
            vendor = vendorFilter, need = needFilter, status = statusFilter, q = searchFilter,
            sort = sort ?? table.SortKey,
            dir = direction ?? table.Direction,
            page = page,
            pageSize = pageSize ?? table.PageSize,
            itemId
        }) ?? "/budget";

    string SortUrl(string key) => TableUrl(
        1, key, key == table.SortKey && table.Direction == "asc" ? "desc" : "asc");
    string SortGlyph(string key) => key == table.SortKey ? (table.Direction == "asc" ? "↑" : "↓") : "↕";
    string SortAria(string key) => key != table.SortKey ? "none" :
        (table.Direction == "asc" ? "ascending" : "descending");

    Guid.TryParse(Context.Request.Query["itemId"].ToString(), out var selectedItemId);
    var selectedItem = selectedItemId == Guid.Empty ? null : snapshot.Items.FirstOrDefault(x => x.Id == selectedItemId);

    var sections = snapshot.Items.Select(x => x.BudgetSectionName).OfType<string>().Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToArray();
    var categories = snapshot.Items.Select(x => x.InternalCategoryName).OfType<string>().Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToArray();
    var locations = snapshot.Items.Select(x => x.LocationName).OfType<string>().Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToArray();
    var vendors = snapshot.Items.Select(x => x.VendorName).OfType<string>().Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToArray();
    var needs = snapshot.Items.Select(x => x.NeedLevelName).OfType<string>().Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).OrderBy(x => x).ToArray();

    var displayedPlanned = filteredItems.Sum(x => x.PlannedTotal);
    var displayedApproved = filteredItems.Sum(x => x.ApprovedTotal ?? 0m);
    var displayedProposed = filteredItems.Where(x => x.Status is BudgetItemStatus.Draft or BudgetItemStatus.Proposed or BudgetItemStatus.Submitted or BudgetItemStatus.Deferred).Sum(x => x.PlannedTotal);
    var mustHave = filteredItems.Count(x => string.Equals(x.NeedLevelName, "Must Have", StringComparison.OrdinalIgnoreCase));

    string FriendlyStatus(BudgetItemStatus status) => status switch
    {
        BudgetItemStatus.Draft => "Planned",
        BudgetItemStatus.Proposed => "Proposed",
        BudgetItemStatus.Submitted => "Submitted",
        BudgetItemStatus.Approved => "Approved",
        BudgetItemStatus.Denied => "Denied",
        BudgetItemStatus.Deferred => "Deferred",
        BudgetItemStatus.Active => "Active",
        BudgetItemStatus.Cancelled => "Cancelled",
        BudgetItemStatus.Archived => "Archived",
        _ => status.ToString()
    };

    string ApprovalLabel(BudgetItemStatus status) => status switch
    {
        BudgetItemStatus.Submitted => "Pending",
        BudgetItemStatus.Approved => "Approved",
        BudgetItemStatus.Denied => "Denied",
        BudgetItemStatus.Deferred => "Deferred",
        _ => "Not Started"
    };

    string BadgeClass(string? value) => value switch
    {
        "Must Have" => "lf-badge-blue",
        "High" => "lf-badge-warning",
        "Moderate" => "lf-badge-gold",
        "Low" => "lf-badge-success",
        _ => "lf-badge-muted"
    };

    var clearUrl = Url.Action("Index", "Budget", new { fiscalYearId = snapshot.SelectedFiscalYearId, versionId = snapshot.SelectedVersionId });
}

<div class="lf-budget-workspace @(selectedItem is null ? string.Empty : "has-drawer")">
    <div class="lf-budget-main">
        <div class="lf-page-header lf-budget-page-header">
            <div>
                <h1 class="lf-page-title">Budget</h1>
                <p class="lf-subtitle">@((snapshot.FiscalYears.FirstOrDefault(x => x.Id == snapshot.SelectedFiscalYearId)?.DisplayName) ?? "Fiscal year") planning and budget management.</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="card lf-alert lf-alert-danger" role="alert">@Model.ErrorMessage</div>
        }
        @if (Model.Saved)
        {
            <div class="card lf-alert lf-alert-success" role="status">Budget item added.</div>
        }
        @if (!string.IsNullOrWhiteSpace(actualError))
        {
            <div class="card lf-alert lf-alert-danger" role="alert">@actualError</div>
        }
        @if (!string.IsNullOrWhiteSpace(actualSuccess))
        {
            <div class="card lf-alert lf-alert-success" role="status">@actualSuccess</div>
        }
        @if (Context.Request.Query.ContainsKey("actualModal") && string.IsNullOrWhiteSpace(actualError) && string.IsNullOrWhiteSpace(actualSuccess))
        {
            <div class="card lf-alert lf-alert-success" role="status">Actuals updated. Review the ledger below.</div>
        }

        @if (snapshot.FiscalYears.Count == 0)
        {
            <section class="card lf-empty-state" aria-labelledby="no-fiscal-year-title">
                <h2 id="no-fiscal-year-title">No fiscal year is available</h2>
                <p class="muted">Create a fiscal year before planning items are entered.</p>
            </section>
        }
        else
        {
            <div class="lf-budget-actions">
                <form method="get" action="/budget" class="lf-budget-context" aria-label="Budget context">
                    <select id="fiscalYearId" name="fiscalYearId" aria-label="Fiscal year">
                        @foreach (var year in snapshot.FiscalYears)
                        {
                            <option value="@year.Id" selected="@(year.Id == snapshot.SelectedFiscalYearId)">@year.DisplayName@(year.IsCurrent ? " · Current" : string.Empty)</option>
                        }
                    </select>
                    <select id="versionId" name="versionId" aria-label="Budget version" disabled="@(snapshot.Versions.Count == 0)">
                        @foreach (var version in snapshot.Versions)
                        {
                            <option value="@version.Id" selected="@(version.Id == snapshot.SelectedVersionId)">v@version.VersionNumber · @version.Name@(version.IsLocked ? " · Locked" : string.Empty)</option>
                        }
                    </select>
                    <button type="submit">Apply</button>
                </form>
                <div class="lf-budget-action-buttons">
                    @if (Model.CanEdit && !snapshot.SelectedVersionLocked && snapshot.SelectedVersionId is not null)
                    {
                        <a class="button primary" href="#new-budget-item" data-open-budget-wizard><span aria-hidden="true">＋</span> New Item</a>
                    }
                    @if (snapshot.SelectedFiscalYearId is not null)
                    {
                        <button class="button" type="button" data-open-actuals-modal><span aria-hidden="true">▤</span> Actuals</button>
                    }
                    @if (canManageImports)
                    {
                        <a class="button" href="/imports"><span aria-hidden="true">⇩</span> Import</a>
                    }
                    @if (snapshot.SelectedFiscalYearId is not null)
                    {
                        <a class="button" href="/exports/budget.csv?fiscalYearId=@snapshot.SelectedFiscalYearId"><span aria-hidden="true">⇩</span> Export</a>
                    }
                    <a class="button" href="/reports">Reports</a>
                </div>
            </div>

            @if (snapshot.SelectedVersionId is not null)
            {
                <form method="get" action="/budget" class="lf-budget-filters" aria-label="Budget filters">
                    <input type="hidden" name="fiscalYearId" value="@snapshot.SelectedFiscalYearId" />
                    <input type="hidden" name="versionId" value="@snapshot.SelectedVersionId" />
                    <input type="hidden" name="sort" value="@table.SortKey" />
                    <input type="hidden" name="dir" value="@table.Direction" />
                    <input type="hidden" name="pageSize" value="@table.PageSize" />
                    <div class="lf-filter-search"><label for="q">Search</label><input id="q" name="q" value="@searchFilter" placeholder="Item # or description" /></div>
                    <div><label for="section">Section</label><select id="section" name="section"><option value="">All</option>@foreach (var value in sections){<option value="@value" selected="@(value == sectionFilter)">@value</option>}</select></div>
                    <div><label for="category">Category</label><select id="category" name="category"><option value="">All</option>@foreach (var value in categories){<option value="@value" selected="@(value == categoryFilter)">@value</option>}</select></div>
                    <div><label for="location">Location</label><select id="location" name="location"><option value="">All</option>@foreach (var value in locations){<option value="@value" selected="@(value == locationFilter)">@value</option>}</select></div>
                    <div><label for="vendor">Vendor</label><select id="vendor" name="vendor"><option value="">All</option>@foreach (var value in vendors){<option value="@value" selected="@(value == vendorFilter)">@value</option>}</select></div>
                    <div><label for="need">Need Level</label><select id="need" name="need"><option value="">All</option>@foreach (var value in needs){<option value="@value" selected="@(value == needFilter)">@value</option>}</select></div>
                    <div><label for="status">Status</label><select id="status" name="status"><option value="">All</option>@foreach (var value in Enum.GetValues<BudgetItemStatus>()){<option value="@value" selected="@(value.ToString() == statusFilter)">@FriendlyStatus(value)</option>}</select></div>
                    <div class="lf-filter-actions"><button type="submit">Apply filters</button><a href="@clearUrl">Clear All</a></div>
                </form>

                <section class="lf-budget-kpis" aria-label="Budget summary">
                    <article class="lf-card lf-budget-kpi"><span class="lf-budget-kpi-icon blue">▥</span><div><strong>@filteredItems.Length</strong><span>Total Items</span></div></article>
                    <article class="lf-card lf-budget-kpi"><span class="lf-budget-kpi-icon gold">★</span><div><strong>@mustHave</strong><span>Must Have</span></div></article>
                    <article class="lf-card lf-budget-kpi"><span class="lf-budget-kpi-icon green">▤</span><div><strong>@displayedPlanned.ToString("C2")</strong><span>Planned Total</span></div></article>
                    <article class="lf-card lf-budget-kpi"><span class="lf-budget-kpi-icon purple">▧</span><div><strong>@displayedProposed.ToString("C2")</strong><span>Open / Proposed</span></div></article>
                    <article class="lf-card lf-budget-kpi"><span class="lf-budget-kpi-icon teal">✓</span><div><strong>@displayedApproved.ToString("C2")</strong><span>Approved</span></div></article>
                </section>

                @if (Model.CanEdit && !snapshot.SelectedVersionLocked && snapshot.SelectedVersionId is not null && createOptions is not null)
                {
                    <section id="new-budget-item" class="lf-card lf-new-item-panel" aria-labelledby="budget-wizard-title" data-open-on-error="@(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "false" : "true")" hidden>
                        <div class="lf-panel-header">
                            <div><h2 id="budget-wizard-title">New budget item</h2><p class="muted">Complete the steps, check the calculated total, then save.</p></div>
                            <button type="button" class="button" data-close-budget-wizard aria-label="Close budget item wizard">Close</button>
                        </div>
                        <form id="lf-budget-create-form" method="post" action="/budget/create" novalidate>
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="fiscalYearId" value="@snapshot.SelectedFiscalYearId" />
                            <input type="hidden" name="versionId" value="@snapshot.SelectedVersionId" />
                            <p class="muted" id="lf-budget-wizard-progress" aria-live="polite">Step 1 of 3</p>
                            <fieldset data-budget-step>
                                <legend><strong>Step 1 — Item details</strong></legend>
                                <div class="lf-form-grid">
                                    <div class="lf-span-all"><label for="create-description">Item Description</label><input id="create-description" name="description" maxlength="500" required /></div>
                                    <div><label for="create-section">Section</label><select id="create-section" name="budgetSectionId"><option value="">Unassigned</option>@foreach(var option in createOptions.BudgetSections){<option value="@option.Id">@option.Code · @option.Name</option>}</select></div>
                                    <div><label for="create-category">Category</label><select id="create-category" name="internalCategoryId"><option value="">Unassigned</option>@foreach(var option in createOptions.InternalCategories){<option value="@option.Id">@option.Name</option>}</select></div>
                                    <div class="lf-span-all"><label for="create-purpose">Purpose</label><textarea id="create-purpose" name="reasonPurpose" rows="3" maxlength="2000"></textarea></div>
                                </div>
                            </fieldset>
                            <fieldset data-budget-step hidden>
                                <legend><strong>Step 2 — Classification</strong></legend>
                                <div class="lf-form-grid">
                                    <div><label for="create-type">Type</label><select id="create-type" name="purchaseType">@foreach(var option in Enum.GetValues<PurchaseType>()){<option value="@option">@option</option>}</select></div>
                                    <div><label for="create-finance-type">Finance type</label><select id="create-finance-type" name="financeTypeId"><option value="">Unassigned</option>@foreach(var option in createOptions.FinanceTypes){<option value="@option.Id">@option.Name</option>}</select></div>
                                    <div><label for="create-location">Location</label><select id="create-location" name="locationId"><option value="">Unassigned</option>@foreach(var option in createOptions.Locations){<option value="@option.Id">@option.Name</option>}</select></div>
                                    <div><label for="create-department">Department</label><select id="create-department" name="departmentId"><option value="">Unassigned</option>@foreach(var option in createOptions.Departments){<option value="@option.Id">@option.Name</option>}</select></div>
                                    <div><label for="create-need">Need Level</label><select id="create-need" name="needLevelId"><option value="">Unassigned</option>@foreach(var option in createOptions.NeedLevels){<option value="@option.Id">@option.Name</option>}</select></div>
                                    <div><label for="create-frequency">Frequency</label><select id="create-frequency" name="frequencyId"><option value="">Unassigned</option>@foreach(var option in createOptions.Frequencies){<option value="@option.Id">@option.Name</option>}</select></div>
                                </div>
                                <div class="lf-form-grid">
                                    <div><label for="create-vendor">Vendor</label><select id="create-vendor" name="vendorId"><option value="">Unassigned</option>@foreach(var option in createOptions.Vendors){<option value="@option.Id">@option.Name</option>}</select></div>
                                </div>
                            </fieldset>
                            <fieldset data-budget-step hidden>
                                <legend><strong>Step 3 — Cost and review</strong></legend>
                                <div class="lf-form-grid">
                                    <div><label for="create-quantity"># of Units</label><input id="create-quantity" name="quantity" type="number" min="0" step="0.0001" value="1" required /></div>
                                    <div><label for="create-unitCost">Cost per Unit</label><input id="create-unitCost" name="unitCost" type="number" min="0" step="0.0001" value="0" required /></div>
                                    <div><label for="create-total">Total Cost (calculated)</label><output id="create-total" class="lf-budget-total">$0.00</output></div>
                                </div>
                                <div class="lf-form-grid"><div class="lf-span-all"><label for="create-notes">Notes</label><textarea id="create-notes" name="notes" rows="3" maxlength="2000" placeholder="Additional planning notes"></textarea></div></div>
                                <p class="muted">Total cost is calculated and validated on the server. After saving, you can add actual transactions from Full Item.</p>
                            </fieldset>
                            <div class="lf-budget-wizard-actions">
                                <button type="button" class="button" data-budget-back hidden>Back</button>
                                <button type="button" class="button primary" data-budget-next>Next</button>
                                <button type="submit" class="primary" data-budget-save hidden>Create Budget Item</button>
                            </div>
                        </form>
                    </section>
                }

                <section class="lf-card lf-budget-grid-card" aria-labelledby="budget-grid-title">
                    <div class="lf-budget-grid-heading">
                        <div><h2 id="budget-grid-title">Budget items</h2><span>@filteredItems.Length of @snapshot.Items.Count shown</span></div>
                        <span class="badge">@(snapshot.SelectedVersionLocked ? "Locked" : "Editable")</span>
                    </div>
                    @if (filteredItems.Length == 0)
                    {
                        <div class="lf-empty-state"><p>No budget items match the current filters.</p></div>
                    }
                    else
                    {
                        <div class="lf-table-scroll">
                            <table class="lf-table lf-budget-grid">
                                <thead>
                                <tr>
                                    <th aria-sort="@SortAria("itemNumber")"><a class="lf-budget-sort-link" href="@SortUrl("itemNumber")">Item # <span aria-hidden="true">@SortGlyph("itemNumber")</span></a></th>
                                    <th aria-sort="@SortAria("description")"><a class="lf-budget-sort-link" href="@SortUrl("description")">Description <span aria-hidden="true">@SortGlyph("description")</span></a></th>
                                    <th aria-sort="@SortAria("section")"><a class="lf-budget-sort-link" href="@SortUrl("section")">Section <span aria-hidden="true">@SortGlyph("section")</span></a></th>
                                    <th aria-sort="@SortAria("category")"><a class="lf-budget-sort-link" href="@SortUrl("category")">Category <span aria-hidden="true">@SortGlyph("category")</span></a></th>
                                    <th aria-sort="@SortAria("vendor")"><a class="lf-budget-sort-link" href="@SortUrl("vendor")">Vendor <span aria-hidden="true">@SortGlyph("vendor")</span></a></th>
                                    <th aria-sort="@SortAria("location")"><a class="lf-budget-sort-link" href="@SortUrl("location")">Location <span aria-hidden="true">@SortGlyph("location")</span></a></th>
                                    <th class="lf-number" aria-sort="@SortAria("quantity")"><a class="lf-budget-sort-link" href="@SortUrl("quantity")">Qty <span aria-hidden="true">@SortGlyph("quantity")</span></a></th>
                                    <th class="lf-number" aria-sort="@SortAria("unitCost")"><a class="lf-budget-sort-link" href="@SortUrl("unitCost")">Unit Cost <span aria-hidden="true">@SortGlyph("unitCost")</span></a></th>
                                    <th class="lf-number" aria-sort="@SortAria("total")"><a class="lf-budget-sort-link" href="@SortUrl("total")">Total <span aria-hidden="true">@SortGlyph("total")</span></a></th>
                                    <th aria-sort="@SortAria("needLevel")"><a class="lf-budget-sort-link" href="@SortUrl("needLevel")">Need Level <span aria-hidden="true">@SortGlyph("needLevel")</span></a></th>
                                    <th aria-sort="@SortAria("frequency")"><a class="lf-budget-sort-link" href="@SortUrl("frequency")">Frequency <span aria-hidden="true">@SortGlyph("frequency")</span></a></th>
                                    <th aria-sort="@SortAria("renewal")"><a class="lf-budget-sort-link" href="@SortUrl("renewal")">Renewal <span aria-hidden="true">@SortGlyph("renewal")</span></a></th>
                                    <th aria-sort="@SortAria("status")"><a class="lf-budget-sort-link" href="@SortUrl("status")">Status <span aria-hidden="true">@SortGlyph("status")</span></a></th>
                                    <th aria-sort="@SortAria("approval")"><a class="lf-budget-sort-link" href="@SortUrl("approval")">Approval <span aria-hidden="true">@SortGlyph("approval")</span></a></th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in table.Rows)
                                {
                                    var selected = selectedItem?.Id == item.Id;
                                    <tr class="@(selected ? "is-selected" : null)">
                                        <td><a href="@TableUrl(table.PageNumber, itemId: item.Id)"><strong>@item.ItemNumber</strong></a></td>
                                        <td><a class="lf-budget-description" href="@TableUrl(table.PageNumber, itemId: item.Id)">@item.Description</a></td>
                                        <td>@(item.BudgetSectionName ?? "—")</td>
                                        <td>@(item.InternalCategoryName ?? item.FinanceTypeName ?? "—")</td>
                                        <td>@(item.VendorName ?? "—")</td>
                                        <td>@(item.LocationName ?? "—")</td>
                                        <td class="lf-number">@item.Quantity.ToString("0.####")</td>
                                        <td class="lf-number">@item.UnitCost.ToString("C2")</td>
                                        <td class="lf-number"><strong>@item.PlannedTotal.ToString("C2")</strong></td>
                                        <td>@if (!string.IsNullOrWhiteSpace(item.NeedLevelName)){<span class="badge @BadgeClass(item.NeedLevelName)">@item.NeedLevelName</span>}else{<span>—</span>}</td>
                                        <td>@(item.FrequencyName ?? "—")</td>
                                        <td>@(item.RenewalDate?.ToString("MM/dd/yyyy") ?? "—")</td>
                                        <td><span class="lf-status-dot"></span>@FriendlyStatus(item.Status)</td>
                                        <td><span class="badge @(item.Status == BudgetItemStatus.Approved ? "lf-badge-success" : item.Status == BudgetItemStatus.Submitted ? "lf-badge-warning" : item.Status == BudgetItemStatus.Denied ? "lf-badge-danger" : "lf-badge-muted")">@ApprovalLabel(item.Status)</span></td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <div class="lf-budget-pagination">
                            <p class="lf-budget-page-summary" role="status">
                                Showing <strong>@table.FirstRow–@table.LastRow</strong> of
                                <strong>@table.TotalCount</strong> matching items
                            </p>
                            <form method="get" action="/budget" class="lf-budget-page-size" aria-label="Rows per page">
                                <input type="hidden" name="fiscalYearId" value="@snapshot.SelectedFiscalYearId" />
                                <input type="hidden" name="versionId" value="@snapshot.SelectedVersionId" />
                                <input type="hidden" name="section" value="@sectionFilter" />
                                <input type="hidden" name="category" value="@categoryFilter" />
                                <input type="hidden" name="location" value="@locationFilter" />
                                <input type="hidden" name="vendor" value="@vendorFilter" />
                                <input type="hidden" name="need" value="@needFilter" />
                                <input type="hidden" name="status" value="@statusFilter" />
                                <input type="hidden" name="q" value="@searchFilter" />
                                <input type="hidden" name="sort" value="@table.SortKey" />
                                <input type="hidden" name="dir" value="@table.Direction" />
                                <input type="hidden" name="page" value="1" />
                                <label for="budget-page-size">Rows per page</label>
                                <select id="budget-page-size" name="pageSize" data-budget-page-size>
                                    @foreach (var size in new[] { 10, 25, 50, 100 })
                                    {
                                        <option value="@size" selected="@(size == table.PageSize)">@size</option>
                                    }
                                </select>
                                <button type="submit">Apply</button>
                            </form>
                            <nav class="lf-budget-page-links" aria-label="Budget item pagination">
                                @if (table.PageNumber > 1)
                                {
                                    <a href="@TableUrl(1)" aria-label="First page">« First</a>
                                    <a href="@TableUrl(table.PageNumber - 1)" aria-label="Previous page">‹ Previous</a>
                                }
                                else
                                {
                                    <span class="is-disabled">« First</span>
                                    <span class="is-disabled">‹ Previous</span>
                                }
                                @for (var pageNum = firstPageLink; pageNum <= lastPageLink; pageNum++)
                                {
                                    if (pageNum == table.PageNumber)
                                    {
                                        <span class="is-current" aria-current="page">@pageNum</span>
                                    }
                                    else
                                    {
                                        <a href="@TableUrl(pageNum)" aria-label="Page @pageNum">@pageNum</a>
                                    }
                                }
                                @if (table.PageNumber < table.TotalPages)
                                {
                                    <a href="@TableUrl(table.PageNumber + 1)" aria-label="Next page">Next ›</a>
                                    <a href="@TableUrl(table.TotalPages)" aria-label="Last page">Last »</a>
                                }
                                else
                                {
                                    <span class="is-disabled">Next ›</span>
                                    <span class="is-disabled">Last »</span>
                                }
                            </nav>
                        </div>
                    }
                </section>
            }
        }
    </div>

    @if (selectedItem is not null)
    {
        <aside class="lf-budget-drawer" aria-label="Selected budget item">
            <div class="lf-drawer-header">
                <div><h2>@selectedItem.ItemNumber</h2><p>@selectedItem.Description</p></div>
                <a class="lf-drawer-close" href="@TableUrl(table.PageNumber)" aria-label="Close item details">×</a>
            </div>
            <nav class="lf-drawer-tabs" aria-label="Budget item sections"><a class="active" href="/budget/items/@selectedItem.Id">Details</a><a href="/budget/items/@selectedItem.Id">Financials</a><a href="/budget/items/@selectedItem.Id">Approvals</a><a href="/documents">Documents</a></nav>
            <div class="lf-drawer-body">
                <dl class="lf-drawer-details">
                    <div><dt>Section</dt><dd>@(selectedItem.BudgetSectionName ?? "—")</dd></div>
                    <div><dt>Category</dt><dd>@(selectedItem.InternalCategoryName ?? selectedItem.FinanceTypeName ?? "—")</dd></div>
                    <div><dt>Vendor</dt><dd>@(selectedItem.VendorName ?? "—")</dd></div>
                    <div><dt>Department</dt><dd>@(selectedItem.DepartmentName ?? "—")</dd></div>
                    <div><dt>Location</dt><dd>@(selectedItem.LocationName ?? "—")</dd></div>
                    <div><dt>Need Level</dt><dd>@(selectedItem.NeedLevelName ?? "—")</dd></div>
                    <div><dt>Frequency</dt><dd>@(selectedItem.FrequencyName ?? "—")</dd></div>
                    <div><dt>Purchase Type</dt><dd>@selectedItem.PurchaseType</dd></div>
                    <div><dt>Qty</dt><dd>@selectedItem.Quantity.ToString("0.####")</dd></div>
                    <div><dt>Unit Cost</dt><dd>@selectedItem.UnitCost.ToString("C2")</dd></div>
                    <div><dt>Total</dt><dd><strong>@selectedItem.PlannedTotal.ToString("C2")</strong></dd></div>
                </dl>

                <section class="lf-drawer-card">
                    <h3>Financial Summary</h3>
                    <div><span>Planned</span><strong>@selectedItem.PlannedTotal.ToString("C2")</strong></div>
                    <div><span>Approved</span><strong>@(selectedItem.ApprovedTotal?.ToString("C2") ?? "$0.00")</strong></div>
                    <div><span>Revised</span><strong>@(selectedItem.RevisedTotal?.ToString("C2") ?? selectedItem.ApprovedTotal?.ToString("C2") ?? selectedItem.PlannedTotal.ToString("C2"))</strong></div>
                    <div><span>Status</span><strong>@FriendlyStatus(selectedItem.Status)</strong></div>
                </section>

                <section class="lf-drawer-card">
                    <h3>Quick Actions</h3>
                    <a class="button primary" href="/budget/items/@selectedItem.Id">Open Full Item</a>
                    <a class="button" href="/purchase-orders">Purchase Orders</a>
                    <a class="button" href="/documents">Documents</a>
                </section>
            </div>
        </aside>
    }
</div>

@if (snapshot.SelectedFiscalYearId is not null)
{
    <dialog id="lf-actuals-dialog" class="lf-budget-actuals-dialog" aria-label="Actuals ledger"
            data-actuals-url="/actuals/modal?fiscalYearId=@snapshot.SelectedFiscalYearId"
            data-open-on-load="@(Context.Request.Query.ContainsKey("actualModal") ? "true" : "false")">
        <div class="lf-actuals-dialog-header">
            <strong>Actuals</strong>
            <button type="button" class="button" data-close-actuals-modal aria-label="Close Actuals">Close</button>
        </div>
        <div class="lf-actuals-dialog-content" data-actuals-content>
            <p role="status">Loading Actuals…</p>
        </div>
    </dialog>
}
