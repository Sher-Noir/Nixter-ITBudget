@model LedgerForge.Infrastructure.Procurement.ContractIndexSnapshot
@{
    ViewData["Title"] = "Contracts";
    var canManage = ViewData["CanManageProcurement"] as bool? == true;
    var errorMessage = ViewData["ErrorMessage"] as string;
    var saved = ViewData["Saved"] as bool? == true;
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
}

<div class="lf-page-header">
    <div>
        <h1 class="lf-page-title">Contracts</h1>
        <p class="lf-subtitle">Vendor agreements, lifecycle state, renewal notice windows, and auditable renewal decisions.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="lf-card lf-alert lf-alert-danger" role="alert">@errorMessage</div>
}
@if (saved)
{
    <div class="lf-card lf-alert lf-alert-success" role="status">Contract saved.</div>
}

@if (canManage)
{
    <section class="lf-card" aria-labelledby="create-contract-title">
        <h2 id="create-contract-title">Create contract</h2>
        @if (Model.Vendors.Count == 0)
        {
            <p class="lf-muted">Create at least one active vendor before entering contracts.</p>
        }
        else
        {
            <form method="post" action="/contracts">
                @Html.AntiForgeryToken()
                <div class="lf-form-grid">
                    <div><label for="vendorId"><strong>Vendor</strong></label><select id="vendorId" name="vendorId" required>@foreach (var option in Model.Vendors) { <option value="@option.Id">@option.Label</option> }</select></div>
                    <div><label for="contractNumber"><strong>Contract number</strong></label><input id="contractNumber" name="contractNumber" maxlength="100" required /></div>
                    <div class="lf-span-all"><label for="name"><strong>Contract name</strong></label><input id="name" name="name" maxlength="250" required /></div>
                    <div><label for="startDate"><strong>Start date</strong></label><input id="startDate" name="startDate" type="date" value="@today.ToString("yyyy-MM-dd")" required /></div>
                    <div><label for="endDate"><strong>End date</strong></label><input id="endDate" name="endDate" type="date" value="@today.AddYears(1).ToString("yyyy-MM-dd")" required /></div>
                    <div><label for="estimatedAnnualAmount"><strong>Estimated annual amount</strong></label><input id="estimatedAnnualAmount" name="estimatedAnnualAmount" type="number" min="0" step="0.0001" value="0" required /></div>
                    <div><label for="renewalNoticeDays"><strong>Renewal notice days</strong></label><input id="renewalNoticeDays" name="renewalNoticeDays" type="number" min="0" max="730" value="60" required /></div>
                    <div><label for="budgetItemId">Budget item</label><select id="budgetItemId" name="budgetItemId"><option value="">Not linked</option>@foreach (var option in Model.BudgetItems) { <option value="@option.Id">@option.Label</option> }</select></div>
                    <div><label for="financeAccountId">Finance account</label><select id="financeAccountId" name="financeAccountId"><option value="">Not linked</option>@foreach (var option in Model.FinanceAccounts) { <option value="@option.Id">@option.Label</option> }</select></div>
                    <div class="lf-span-all"><label for="description">Description</label><textarea id="description" name="description" rows="3" maxlength="2000"></textarea></div>
                    <div class="lf-span-all lf-check"><label><input type="checkbox" name="autoRenew" value="true" /> Auto-renewing agreement</label></div>
                </div>
                <p><button class="primary" type="submit">Create draft contract</button></p>
            </form>
        }
    </section>
}

<section class="lf-card" aria-labelledby="contract-register-title">
    <div class="lf-panel-header"><div><h2 id="contract-register-title">Contract register</h2><p class="lf-muted">Ordered by end date to surface upcoming renewal exposure.</p></div><span class="badge">@Model.Contracts.Count contract@(Model.Contracts.Count == 1 ? string.Empty : "s")</span></div>
    @if (Model.Contracts.Count == 0)
    {
        <div class="lf-empty-state"><p>No contracts have been entered.</p></div>
    }
    else
    {
        <div class="lf-table-wrap">
            <table class="lf-table">
                <thead><tr><th>Contract</th><th>Vendor</th><th>State</th><th>Dates</th><th>Notice date</th><th>Renewal</th><th class="lf-number">Annual estimate</th></tr></thead>
                <tbody>
                @foreach (var contract in Model.Contracts)
                {
                    <tr>
                        <td><a href="/contracts/@contract.Id"><strong>@contract.ContractNumber</strong></a><br />@contract.Name</td>
                        <td>@contract.Vendor</td>
                        <td><span class="badge">@contract.State</span></td>
                        <td>@contract.StartDate.ToString("yyyy-MM-dd") – @contract.EndDate.ToString("yyyy-MM-dd")</td>
                        <td>@contract.RenewalNoticeDate.ToString("yyyy-MM-dd")</td>
                        <td>@(contract.RenewalStatus?.ToString() ?? "—")@(contract.AutoRenew ? " · Auto" : string.Empty)</td>
                        <td class="lf-number">@contract.EstimatedAnnualAmount.ToString("C2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
