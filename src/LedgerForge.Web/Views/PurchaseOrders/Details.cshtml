@model LedgerForge.Infrastructure.Procurement.PurchaseOrderDetailSnapshot
@using LedgerForge.Domain.Procurement
@{
    ViewData["Title"] = $"PO {Model.Order.Number}";
    var canManage = ViewData["CanManageProcurement"] as bool? == true;
    var canApprove = ViewData["CanApprove"] as bool? == true;
    var errorMessage = ViewData["ErrorMessage"] as string;
    var saved = ViewData["Saved"] as bool? == true;
    var isDraft = Model.Order.State == PurchaseOrderState.Draft;
    var suggestedChangeOrderNumber = $"{Model.Order.Number}-CO{Model.Order.ChangeOrderSequence + 1}";
}

<div class="lf-page-header">
    <div>
        <h1 class="lf-page-title">Purchase Order @Model.Order.Number</h1>
        <p class="lf-subtitle">@Model.Order.Vendor · @Model.Order.FiscalYear · @Model.Order.Description</p>
        @if (Model.Order.ChangeOrderSequence > 0)
        {
            <span class="badge">Change order @Model.Order.ChangeOrderSequence</span>
        }
    </div>
    <a class="button" href="/purchase-orders">Back to purchase orders</a>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="lf-card lf-alert lf-alert-danger" role="alert">@errorMessage</div>
}
@if (saved)
{
    <div class="lf-card lf-alert lf-alert-success" role="status">Purchase order change saved.</div>
}

@if (Model.SupersededOrder is not null || Model.ChangeOrder is not null)
{
    <section class="lf-card" aria-labelledby="po-lineage-title">
        <div class="lf-panel-header"><h2 id="po-lineage-title">Change-order lineage</h2></div>
        <div class="lf-toolbar">
            @if (Model.SupersededOrder is not null)
            {
                <a class="button" href="/purchase-orders/@Model.SupersededOrder.Id">← Supersedes @Model.SupersededOrder.Number (@Model.SupersededOrder.State)</a>
            }
            @if (Model.ChangeOrder is not null)
            {
                <a class="button" href="/purchase-orders/@Model.ChangeOrder.Id">Superseded by @Model.ChangeOrder.Number (@Model.ChangeOrder.State) →</a>
            }
        </div>
    </section>
}

<div class="lf-kpi-grid">
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon orange">PO</div><div><div class="lf-card-title">State</div><div class="lf-kpi-value">@Model.Order.State</div><div class="lf-kpi-note">Current procurement workflow state</div></div></article>
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon blue">$</div><div><div class="lf-card-title">Order Total</div><div class="lf-kpi-value">@Model.Order.Total.ToString("C2")</div><div class="lf-kpi-note">Sum of purchase-order lines</div></div></article>
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon teal">#</div><div><div class="lf-card-title">Lines</div><div class="lf-kpi-value">@Model.Lines.Count</div><div class="lf-kpi-note">Coded commitment lines</div></div></article>
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon green">R</div><div><div class="lf-card-title">Receipts</div><div class="lf-kpi-value">@Model.Receipts.Count</div><div class="lf-kpi-note">Recorded receiving events</div></div></article>
</div>

@if (canManage || canApprove)
{
    <section class="lf-card" aria-labelledby="workflow-title">
        <h2 id="workflow-title">Workflow actions</h2>
        <div class="lf-toolbar">
            @if (canManage && Model.Order.State == PurchaseOrderState.Draft)
            {
                <form method="post" action="/purchase-orders/@Model.Order.Id/submit">@Html.AntiForgeryToken()<button class="primary" type="submit">Submit for approval</button></form>
            }
            @if (canApprove && Model.Order.State == PurchaseOrderState.PendingApproval)
            {
                <form method="post" action="/purchase-orders/@Model.Order.Id/approve">@Html.AntiForgeryToken()<button class="primary" type="submit">Approve purchase order</button></form>
                <a class="button" href="/approvals">Open approval queue to reject</a>
            }
            @if (canManage && Model.Order.State == PurchaseOrderState.Approved)
            {
                <form method="post" action="/purchase-orders/@Model.Order.Id/issue">@Html.AntiForgeryToken()<button class="primary" type="submit">Issue purchase order</button></form>
            }
            @if (canManage && Model.Order.State == PurchaseOrderState.Issued)
            {
                <form method="post" action="/purchase-orders/@Model.Order.Id/close">@Html.AntiForgeryToken()<button type="submit">Close purchase order</button></form>
            }
        </div>
        @if (canManage && Model.Order.State is not (PurchaseOrderState.Closed or PurchaseOrderState.Cancelled or PurchaseOrderState.Rejected))
        {
            <details>
                <summary>Cancel purchase order</summary>
                <form method="post" action="/purchase-orders/@Model.Order.Id/cancel">
                    @Html.AntiForgeryToken()
                    <p><label for="cancelReason"><strong>Cancellation reason</strong></label><input id="cancelReason" name="reason" maxlength="1000" required /></p>
                    <button type="submit">Cancel purchase order</button>
                </form>
            </details>
        }
    </section>
}

@if (canManage && Model.Order.State == PurchaseOrderState.Issued && Model.ChangeOrder is null)
{
    <section class="lf-card" aria-labelledby="change-order-title">
        <div class="lf-panel-header"><div><h2 id="change-order-title">Create change order</h2><p class="lf-muted">Creates a new draft revision with copied lines. The current issued PO remains authoritative until the revision is approved and issued; issuing the revision closes this PO atomically.</p></div></div>
        <form method="post" action="/purchase-orders/@Model.Order.Id/change-orders">
            @Html.AntiForgeryToken()
            <div class="lf-form-grid">
                <div><label for="newNumber"><strong>New PO number</strong></label><input id="newNumber" name="newNumber" maxlength="100" required value="@suggestedChangeOrderNumber" /></div>
                <div class="lf-span-all"><label for="changeDescription"><strong>Change-order description</strong></label><input id="changeDescription" name="description" maxlength="500" required value="Change order to @Model.Order.Number" /></div>
            </div>
            <p><button type="submit">Create draft change order</button></p>
        </form>
    </section>
}

@if (canManage && isDraft)
{
    <section class="lf-card" aria-labelledby="add-line-title">
        <h2 id="add-line-title">Add commitment line</h2>
        <form method="post" action="/purchase-orders/@Model.Order.Id/lines">
            @Html.AntiForgeryToken()
            <div class="lf-form-grid">
                <div class="lf-span-all"><label for="description"><strong>Description</strong></label><input id="description" name="description" maxlength="500" required /></div>
                <div><label for="quantity"><strong>Quantity</strong></label><input id="quantity" name="quantity" type="number" min="0.0001" step="0.0001" value="1" required /></div>
                <div><label for="unitCost"><strong>Unit cost</strong></label><input id="unitCost" name="unitCost" type="number" min="0" step="0.0001" required /></div>
                <div><label for="budgetItemId">Budget item</label><select id="budgetItemId" name="budgetItemId"><option value="">Unallocated</option>@foreach (var option in Model.BudgetItems) { <option value="@option.Id">@option.Label</option> }</select></div>
                <div><label for="financeAccountId">Finance account</label><select id="financeAccountId" name="financeAccountId"><option value="">Unallocated</option>@foreach (var option in Model.FinanceAccounts) { <option value="@option.Id">@option.Label</option> }</select></div>
                <div><label for="departmentId">Department</label><select id="departmentId" name="departmentId"><option value="">Unallocated</option>@foreach (var option in Model.Departments) { <option value="@option.Id">@option.Label</option> }</select></div>
                <div><label for="locationId">Location</label><select id="locationId" name="locationId"><option value="">Unallocated</option>@foreach (var option in Model.Locations) { <option value="@option.Id">@option.Label</option> }</select></div>
            </div>
            <p><button class="primary" type="submit">Add line</button></p>
        </form>
    </section>
}

<section class="lf-card" aria-labelledby="lines-title">
    <div class="lf-panel-header"><div><h2 id="lines-title">Purchase-order lines</h2><p class="lf-muted">Line dimensions are captured at commitment time; received and remaining quantities are derived from immutable receipts.</p></div><span class="badge">@Model.Lines.Count line@(Model.Lines.Count == 1 ? string.Empty : "s")</span></div>
    @if (Model.Lines.Count == 0)
    {
        <div class="lf-empty-state"><p>No lines have been added to this purchase order.</p></div>
    }
    else
    {
        <div class="lf-table-wrap">
            <table class="lf-table">
                <thead><tr><th>Line</th><th>Description</th><th>Budget item</th><th>Account</th><th>Department</th><th>Location</th><th class="lf-number">Ordered</th><th class="lf-number">Received</th><th class="lf-number">Remaining</th><th class="lf-number">Unit cost</th><th class="lf-number">Total</th></tr></thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr><td>@line.LineNumber</td><td>@line.Description</td><td>@(line.BudgetItem ?? "—")</td><td>@(line.FinanceAccount ?? "—")</td><td>@(line.Department ?? "—")</td><td>@(line.Location ?? "—")</td><td class="lf-number">@line.Quantity.ToString("N4")</td><td class="lf-number">@line.ReceivedQuantity.ToString("N4")</td><td class="lf-number">@line.RemainingQuantity.ToString("N4")</td><td class="lf-number">@line.UnitCost.ToString("C2")</td><td class="lf-number">@line.LineTotal.ToString("C2")</td></tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

@if (canManage && isDraft && Model.Lines.Count > 0)
{
    <section class="lf-card" aria-labelledby="edit-lines-title">
        <div class="lf-panel-header">
            <div>
                <h2 id="edit-lines-title">Edit draft lines</h2>
                <p class="lf-muted">Update quantity, price, description, or coding before submission. Blank coding selections keep the line's current assignment.</p>
            </div>
        </div>
        @foreach (var line in Model.Lines)
        {
            <details>
                <summary>Line @line.LineNumber · @line.Description · @line.LineTotal.ToString("C2")</summary>
                <form method="post" action="/purchase-orders/@Model.Order.Id/lines/@line.Id/update">
                    @Html.AntiForgeryToken()
                    <div class="lf-form-grid">
                        <div class="lf-span-all"><label>Description<input name="description" maxlength="500" required value="@line.Description" /></label></div>
                        <div><label>Quantity<input name="quantity" type="number" min="0.0001" step="0.0001" required value="@line.Quantity" /></label></div>
                        <div><label>Unit cost<input name="unitCost" type="number" min="0" step="0.0001" required value="@line.UnitCost" /></label></div>
                        <div><label>Budget item<select name="budgetItemId"><option value="">Keep current</option>@foreach (var option in Model.BudgetItems) { <option value="@option.Id">@option.Label</option> }</select></label></div>
                        <div><label>Finance account<select name="financeAccountId"><option value="">Keep current</option>@foreach (var option in Model.FinanceAccounts) { <option value="@option.Id">@option.Label</option> }</select></label></div>
                        <div><label>Department<select name="departmentId"><option value="">Keep current</option>@foreach (var option in Model.Departments) { <option value="@option.Id">@option.Label</option> }</select></label></div>
                        <div><label>Location<select name="locationId"><option value="">Keep current</option>@foreach (var option in Model.Locations) { <option value="@option.Id">@option.Label</option> }</select></label></div>
                    </div>
                    <p><button type="submit">Save line</button></p>
                </form>
                <form method="post" action="/purchase-orders/@Model.Order.Id/lines/@line.Id/delete">
                    @Html.AntiForgeryToken()
                    <button type="submit">Delete draft line</button>
                </form>
            </details>
        }
    </section>
}

@if (canManage && Model.Order.State == PurchaseOrderState.Issued && Model.Lines.Count > 0)
{
    <section class="lf-card" aria-labelledby="record-receipt-title">
        <div class="lf-panel-header"><div><h2 id="record-receipt-title">Record receipt</h2><p class="lf-muted">Enter quantities received in one delivery. LedgerForge rejects quantities that would exceed the ordered amount.</p></div></div>
        <form method="post" action="/purchase-orders/@Model.Order.Id/receipts">
            @Html.AntiForgeryToken()
            <div class="lf-form-grid">
                <div><label for="receiptNumber"><strong>Receipt / delivery reference</strong></label><input id="receiptNumber" name="receiptNumber" maxlength="100" required /></div>
                <div><label for="receivedDate"><strong>Received date</strong></label><input id="receivedDate" name="receivedDate" type="date" required /></div>
                <div class="lf-span-all"><label for="receiptNote">Note</label><input id="receiptNote" name="note" maxlength="1000" /></div>
            </div>
            <div class="lf-table-wrap">
                <table class="lf-table">
                    <thead><tr><th>Line</th><th>Description</th><th class="lf-number">Remaining</th><th>Receive now</th></tr></thead>
                    <tbody>
                    @foreach (var line in Model.Lines.Where(x => x.RemainingQuantity > 0m))
                    {
                        <tr><td>@line.LineNumber</td><td>@line.Description</td><td class="lf-number">@line.RemainingQuantity.ToString("N4")</td><td><input name="quantities[@line.Id]" type="number" min="0" max="@line.RemainingQuantity" step="0.0001" value="0" aria-label="Quantity received for line @line.LineNumber" /></td></tr>
                    }
                    </tbody>
                </table>
            </div>
            <p><button class="primary" type="submit">Record receipt</button></p>
        </form>
    </section>
}

<section class="lf-card" aria-labelledby="receipt-history-title">
    <div class="lf-panel-header"><div><h2 id="receipt-history-title">Receipt history</h2><p class="lf-muted">Receiving records remain attached to the PO revision where they occurred.</p></div><span class="badge">@Model.Receipts.Count receipt@(Model.Receipts.Count == 1 ? string.Empty : "s")</span></div>
    @if (Model.Receipts.Count == 0)
    {
        <div class="lf-empty-state"><p>No receipts have been recorded for this purchase order.</p></div>
    }
    else
    {
        <div class="lf-table-wrap"><table class="lf-table"><thead><tr><th>Reference</th><th>Date</th><th>Received by</th><th>Lines</th><th>Note</th></tr></thead><tbody>
        @foreach (var receipt in Model.Receipts)
        {
            <tr><td><strong>@receipt.ReceiptNumber</strong></td><td>@receipt.ReceivedDate.ToString("yyyy-MM-dd")</td><td>@receipt.ReceivedBy</td><td>@string.Join("; ", receipt.Lines.Select(x => $"L{x.PurchaseOrderLineNumber}: {x.QuantityReceived:N4}"))</td><td>@(receipt.Note ?? "—")</td></tr>
        }
        </tbody></table></div>
    }
</section>
