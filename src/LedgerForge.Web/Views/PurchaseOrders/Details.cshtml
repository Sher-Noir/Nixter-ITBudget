@model LedgerForge.Infrastructure.Procurement.PurchaseOrderDetailSnapshot
@using LedgerForge.Domain.Procurement
@{
    ViewData["Title"] = $"PO {Model.Order.Number}";
    var canManage = ViewData["CanManageProcurement"] as bool? == true;
    var canApprove = ViewData["CanApprove"] as bool? == true;
    var errorMessage = ViewData["ErrorMessage"] as string;
    var saved = ViewData["Saved"] as bool? == true;
    var isDraft = Model.Order.State == PurchaseOrderState.Draft;
}

<div class="lf-page-header">
    <div>
        <h1 class="lf-page-title">Purchase Order @Model.Order.Number</h1>
        <p class="lf-subtitle">@Model.Order.Vendor · @Model.Order.FiscalYear · @Model.Order.Description</p>
    </div>
    <a class="button" href="/purchase-orders">Back to purchase orders</a>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="lf-card lf-alert lf-alert-danger" role="alert">@errorMessage</div>
}
@if (saved)
{
    <div class="lf-card lf-alert lf-alert-success" role="status">Purchase order workflow saved.</div>
}

<div class="lf-kpi-grid">
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon orange">PO</div><div><div class="lf-card-title">State</div><div class="lf-kpi-value">@Model.Order.State</div><div class="lf-kpi-note">Current procurement workflow state</div></div></article>
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon blue">$</div><div><div class="lf-card-title">Order Total</div><div class="lf-kpi-value">@Model.Order.Total.ToString("C2")</div><div class="lf-kpi-note">Sum of purchase-order lines</div></div></article>
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon teal">#</div><div><div class="lf-card-title">Lines</div><div class="lf-kpi-value">@Model.Lines.Count</div><div class="lf-kpi-note">Coded commitment lines</div></div></article>
</div>

@if (canManage || canApprove)
{
    <section class="lf-card" aria-labelledby="workflow-title">
        <h2 id="workflow-title">Workflow actions</h2>
        <div class="lf-toolbar">
            @if (canManage && Model.Order.State == PurchaseOrderState.Draft)
            {
                <form method="post" action="/purchase-orders/@Model.Order.Id/submit">@Html.AntiForgeryToken()<button class="primary" type="submit">Submit for approval</button></form>
            }
            @if (canApprove && Model.Order.State == PurchaseOrderState.PendingApproval)
            {
                <form method="post" action="/purchase-orders/@Model.Order.Id/approve">@Html.AntiForgeryToken()<button class="primary" type="submit">Approve purchase order</button></form>
                <a class="button" href="/approvals">Open approval queue to reject</a>
            }
            @if (canManage && Model.Order.State == PurchaseOrderState.Approved)
            {
                <form method="post" action="/purchase-orders/@Model.Order.Id/issue">@Html.AntiForgeryToken()<button class="primary" type="submit">Issue purchase order</button></form>
            }
            @if (canManage && Model.Order.State == PurchaseOrderState.Issued)
            {
                <form method="post" action="/purchase-orders/@Model.Order.Id/close">@Html.AntiForgeryToken()<button type="submit">Close purchase order</button></form>
            }
        </div>
        @if (canManage && Model.Order.State is not (PurchaseOrderState.Closed or PurchaseOrderState.Cancelled or PurchaseOrderState.Rejected))
        {
            <details>
                <summary>Cancel purchase order</summary>
                <form method="post" action="/purchase-orders/@Model.Order.Id/cancel">
                    @Html.AntiForgeryToken()
                    <p><label for="cancelReason"><strong>Cancellation reason</strong></label><input id="cancelReason" name="reason" maxlength="1000" required /></p>
                    <button type="submit">Cancel purchase order</button>
                </form>
            </details>
        }
    </section>
}

@if (canManage && isDraft)
{
    <section class="lf-card" aria-labelledby="add-line-title">
        <h2 id="add-line-title">Add commitment line</h2>
        <form method="post" action="/purchase-orders/@Model.Order.Id/lines">
            @Html.AntiForgeryToken()
            <div class="lf-form-grid">
                <div class="lf-span-all">
                    <label for="description"><strong>Description</strong></label>
                    <input id="description" name="description" maxlength="500" required />
                </div>
                <div>
                    <label for="quantity"><strong>Quantity</strong></label>
                    <input id="quantity" name="quantity" type="number" min="0.0001" step="0.0001" value="1" required />
                </div>
                <div>
                    <label for="unitCost"><strong>Unit cost</strong></label>
                    <input id="unitCost" name="unitCost" type="number" min="0" step="0.0001" required />
                </div>
                <div>
                    <label for="budgetItemId">Budget item</label>
                    <select id="budgetItemId" name="budgetItemId">
                        <option value="">Unallocated</option>
                        @foreach (var option in Model.BudgetItems) { <option value="@option.Id">@option.Label</option> }
                    </select>
                </div>
                <div>
                    <label for="financeAccountId">Finance account</label>
                    <select id="financeAccountId" name="financeAccountId">
                        <option value="">Unallocated</option>
                        @foreach (var option in Model.FinanceAccounts) { <option value="@option.Id">@option.Label</option> }
                    </select>
                </div>
                <div>
                    <label for="departmentId">Department</label>
                    <select id="departmentId" name="departmentId">
                        <option value="">Unallocated</option>
                        @foreach (var option in Model.Departments) { <option value="@option.Id">@option.Label</option> }
                    </select>
                </div>
                <div>
                    <label for="locationId">Location</label>
                    <select id="locationId" name="locationId">
                        <option value="">Unallocated</option>
                        @foreach (var option in Model.Locations) { <option value="@option.Id">@option.Label</option> }
                    </select>
                </div>
            </div>
            <p><button class="primary" type="submit">Add line</button></p>
        </form>
    </section>
}

<section class="lf-card" aria-labelledby="lines-title">
    <div class="lf-panel-header">
        <div><h2 id="lines-title">Purchase-order lines</h2><p class="lf-muted">Line dimensions are captured at commitment time for later budget and spend analysis.</p></div>
        <span class="badge">@Model.Lines.Count line@(Model.Lines.Count == 1 ? string.Empty : "s")</span>
    </div>
    @if (Model.Lines.Count == 0)
    {
        <div class="lf-empty-state"><p>No lines have been added to this purchase order.</p></div>
    }
    else
    {
        <div class="lf-table-wrap">
            <table class="lf-table">
                <thead><tr><th>Line</th><th>Description</th><th>Budget item</th><th>Account</th><th>Department</th><th>Location</th><th class="lf-number">Qty</th><th class="lf-number">Unit cost</th><th class="lf-number">Total</th></tr></thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.LineNumber</td><td>@line.Description</td><td>@(line.BudgetItem ?? "—")</td><td>@(line.FinanceAccount ?? "—")</td><td>@(line.Department ?? "—")</td><td>@(line.Location ?? "—")</td><td class="lf-number">@line.Quantity.ToString("N4")</td><td class="lf-number">@line.UnitCost.ToString("C2")</td><td class="lf-number">@line.LineTotal.ToString("C2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
