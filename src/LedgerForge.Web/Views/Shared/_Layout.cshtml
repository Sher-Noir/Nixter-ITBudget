@using LedgerForge.Web.Configuration
@using LedgerForge.Web.Security
@using Microsoft.AspNetCore.Authorization
@inject OrganizationSettingsStore OrganizationSettings
@inject LedgerForge.Web.Documents.BrandingAssetService BrandingAssets
@inject IAuthorizationService AuthorizationService
@{
    var branding = await OrganizationSettings.GetAsync(Context.RequestAborted);
    var uploadedOrganizationLogo = await BrandingAssets.GetOrganizationLogoAsync(Context.RequestAborted);
    var uploadedOrganizationIcon = await BrandingAssets.GetOrganizationIconAsync(Context.RequestAborted);
    var pageTitle = ViewData["Title"] as string;
    var title = string.IsNullOrWhiteSpace(pageTitle) ? branding.ProductName : $"{pageTitle} - {branding.ProductName}";
    var userName = User.Identity?.Name ?? "Signed-in user";
    var displayUserName = userName.Split('\\', StringSplitOptions.RemoveEmptyEntries).LastOrDefault() ?? userName;
    var userInitial = displayUserName.FirstOrDefault().ToString().ToUpperInvariant();
    async Task<bool> CanView(LedgerForgeModule module) => (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.ModulePolicy(module, ModuleAccessLevel.View))).Succeeded;
    var canDashboard = await CanView(LedgerForgeModule.Dashboard);
    var canBudget = await CanView(LedgerForgeModule.Budget);
    var canProcurement = await CanView(LedgerForgeModule.Procurement);
    var canVendors = await CanView(LedgerForgeModule.Vendors);
    var canContracts = await CanView(LedgerForgeModule.Contracts);
    var canRenewals = await CanView(LedgerForgeModule.Renewals);
    var canDocuments = await CanView(LedgerForgeModule.Documents);
    var canApprovals = await CanView(LedgerForgeModule.Approvals);
    var canReports = await CanView(LedgerForgeModule.Reports);
    var canFiscalYears = await CanView(LedgerForgeModule.FiscalYears);
    var canAdminister = (await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.Administration)).Succeeded;
    var headerSearchQuery = Context.Request.Path.StartsWithSegments("/search") ? Context.Request.Query["q"].ToString() : string.Empty;
    bool IsActive(string prefix) => Context.Request.Path.StartsWithSegments(prefix, StringComparison.OrdinalIgnoreCase);
}
<!doctype html>
<html lang="en" data-default-theme="@branding.DefaultTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>@title</title>
    @if (uploadedOrganizationIcon is not null)
    {
        <link rel="icon" href="/branding-assets/organization/icon" />
    }
    else if (!string.IsNullOrWhiteSpace(branding.IconPath))
    {
        <link rel="icon" href="@branding.IconPath" />
    }
    <link rel="stylesheet" href="~/css/ledgerforge.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ledgerforge-budget.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ledgerforge-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ledgerforge-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ledgerforge-item.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ledgerforge-adminnav.css" asp-append-version="true" />
</head>
<body>
<div class="lf-shell">
    <aside class="lf-sidebar" aria-label="Primary navigation">
        <a class="lf-brand" href="/" aria-label="@branding.ProductName home">
            @if (uploadedOrganizationLogo is not null)
            {
                <img src="/branding-assets/organization/logo" alt="" class="lf-brand-logo" />
            }
            else if (!string.IsNullOrWhiteSpace(branding.LogoPath))
            {
                <img src="@branding.LogoPath" alt="" class="lf-brand-logo" />
            }
            else
            {
                <span class="lf-brand-mark" aria-hidden="true">LF</span>
            }
            <span class="lf-brand-copy">@branding.ProductName</span>
        </a>
        <nav class="lf-nav">
            @if (canDashboard || canBudget || canFiscalYears)
            {
                <div class="lf-nav-heading">Planning</div>
                @if (canDashboard) { <a href="/" class="@(Context.Request.Path == "/" ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">⌂</span><span>Dashboard</span></a> }
                @if (canBudget) { <a href="/budget" class="@(IsActive("/budget") || IsActive("/actuals") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">◔</span><span>Budget</span></a> }
                @if (canFiscalYears) { <a href="/fiscal-years" class="@(IsActive("/fiscal-years") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">▣</span><span>Fiscal Years</span></a> }
            }

            @if (canProcurement || canVendors || canContracts || canRenewals)
            {
                <div class="lf-nav-heading">Procurement</div>
                @if (canProcurement) { <a href="/purchase-orders" class="@(IsActive("/purchase-orders") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">◫</span><span>Purchase Orders</span></a> }
                @if (canProcurement) { <a href="/invoices" class="@(IsActive("/invoices") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">▤</span><span>Invoices</span></a> }
                @if (canVendors) { <a href="/vendors" class="@(IsActive("/vendors") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">♧</span><span>Vendors</span></a> }
                @if (canContracts) { <a href="/contracts" class="@(IsActive("/contracts") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">▧</span><span>Contracts</span></a> }
                @if (canRenewals) { <a href="/renewals" class="@(IsActive("/renewals") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">↻</span><span>Renewals</span></a> }
            }

            @if (canDocuments || canApprovals || canReports)
            {
                <div class="lf-nav-heading">Workspace</div>
                @if (canDocuments) { <a href="/documents" class="@(IsActive("/documents") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">□</span><span>Documents</span></a> }
                @if (canApprovals) { <a href="/approvals" class="@(IsActive("/approvals") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">✓</span><span>Approvals</span></a> }
                @if (canReports) { <a href="/reports" class="@(IsActive("/reports") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">▥</span><span>Reports</span></a> }
            }

            @if (canAdminister)
            {
                <div class="lf-nav-heading">System</div>
                <a href="/admin/organization" class="@(IsActive("/admin") ? "active" : null)"><span class="lf-nav-icon" aria-hidden="true">⚙</span><span>Administration</span></a>
            }
        </nav>
        <div class="lf-sidebar-footer">
            <strong>@branding.OrganizationName</strong>
            <span>@branding.ApplicationTitle</span>
        </div>
    </aside>

    <div class="lf-main">
        <header class="lf-topbar">
            <button class="lf-mobile-menu" type="button" data-mobile-menu aria-label="Open navigation">☰</button>
            @if (canFiscalYears)
            {
                <a class="lf-fy-control" href="/fiscal-years" title="Open fiscal years"><span aria-hidden="true">▣</span><strong>@branding.DefaultFiscalYearLabel</strong><span aria-hidden="true">⌄</span></a>
            }
            <form class="lf-search" method="get" action="/search" role="search">
                <span aria-hidden="true">⌕</span>
                <input type="search" name="q" value="@headerSearchQuery" minlength="2" maxlength="100" placeholder="Search budgets, vendors, POs, invoices, contracts..." aria-label="Search LedgerForge" />
            </form>
            <div class="lf-top-actions">
                @if (canReports) { <a class="button lf-export-button" href="/exports"><span aria-hidden="true">⇩</span> Export <span aria-hidden="true">⌄</span></a> }
                @if (canApprovals) { <a class="lf-icon-button" href="/approvals" aria-label="Open approvals" title="Approvals"><span aria-hidden="true">♧</span></a> }
                <button class="lf-theme-toggle lf-icon-button" type="button" data-theme-toggle aria-label="Toggle color theme" title="Toggle color theme"><span data-theme-icon aria-hidden="true">☾</span><span class="visually-hidden" data-theme-label>Dark mode</span></button>
                <a class="lf-user" href="/profile" title="Open profile">
                    <span class="lf-avatar" aria-hidden="true">@userInitial</span>
                    <span class="lf-user-name">@displayUserName</span>
                    <span class="lf-user-caret" aria-hidden="true">⌄</span>
                </a>
            </div>
        </header>

        <main class="lf-content" role="main">
            @if (canAdminister && IsActive("/admin"))
            {
                <nav class="lf-admin-subnav" aria-label="Administration sections">
                    <a href="/admin/organization" class="@(IsActive("/admin/organization") ? "active" : null)">Organization</a>
                    <a href="/admin/lookups" class="@(IsActive("/admin/lookups") ? "active" : null)">Managed Lookups</a>
                    <a href="/admin/finance" class="@(IsActive("/admin/finance") ? "active" : null)">Finance</a>
                    <a href="/admin/security" class="@(IsActive("/admin/security") ? "active" : null)">Security</a>
                    <a href="/admin/diagnostics" class="@(IsActive("/admin/diagnostics") ? "active" : null)">Diagnostics</a>
                    <a href="/imports">Imports</a>
                    <a href="/work">Work Center</a>
                </nav>
            }
            @RenderBody()
            <footer class="lf-footer">@branding.FooterText</footer>
        </main>
    </div>
</div>
<script src="~/js/ledgerforge-theme.js" asp-append-version="true"></script>
<script src="~/js/ledgerforge-ui.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>