@model LedgerForge.Web.Models.FiscalYears.FiscalYearIndexViewModel
@{
    ViewData["Title"] = "Fiscal Years";
    var today = DateOnly.FromDateTime(DateTime.UtcNow);
    var defaultStart = new DateOnly(today.Year, 1, 1);
    var defaultEnd = new DateOnly(today.Year, 12, 31);
}

<div class="lf-page-header">
    <div>
        <h1 class="lf-page-title">Fiscal Years</h1>
        <p class="lf-subtitle">Create planning years, monthly periods, and initial budget versions.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="card" role="alert" style="margin-bottom:1rem;border-color:var(--lf-danger)">@Model.ErrorMessage</div>
}

<div class="lf-settings-grid">
    <section class="card" aria-labelledby="fiscal-list-title">
        <div class="lf-panel-header"><h2 id="fiscal-list-title">Configured fiscal years</h2></div>
        @if (Model.FiscalYears.Count == 0)
        {
            <p class="muted">No fiscal years have been configured yet.</p>
        }
        else
        {
            <div style="overflow-x:auto">
                <table class="lf-table">
                    <thead><tr><th>Fiscal year</th><th>Dates</th><th>Status</th><th>Periods</th><th>Versions</th><th>Current</th></tr></thead>
                    <tbody>
                    @foreach (var year in Model.FiscalYears)
                    {
                        <tr>
                            <td><a href="/fiscal-years/@year.Id"><strong>@year.DisplayName</strong></a><br /><span class="muted">Planning @year.PlanningYear</span></td>
                            <td>@year.StartDate.ToString("yyyy-MM-dd") – @year.EndDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge">@year.Status</span>@(year.IsLocked ? " · Locked" : string.Empty)</td>
                            <td>@year.PeriodCount</td>
                            <td>@year.VersionCount</td>
                            <td>@(year.IsCurrent ? "Yes" : "—")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <aside class="card" aria-labelledby="create-fiscal-title">
        <h2 id="create-fiscal-title">Create fiscal year</h2>
        <form method="post" action="/fiscal-years">
            @Html.AntiForgeryToken()
            <p><label for="displayName"><strong>Display name</strong></label><input id="displayName" name="displayName" placeholder="FY2027" maxlength="32" required /></p>
            <div class="lf-form-grid">
                <div><label for="startDate"><strong>Start date</strong></label><input id="startDate" name="startDate" type="date" value="@defaultStart.ToString("yyyy-MM-dd")" required /></div>
                <div><label for="endDate"><strong>End date</strong></label><input id="endDate" name="endDate" type="date" value="@defaultEnd.ToString("yyyy-MM-dd")" required /></div>
            </div>
            <p><label for="planningYear"><strong>Planning year</strong></label><input id="planningYear" name="planningYear" type="number" min="1900" max="9999" value="@today.Year" required /></p>
            <p><label for="initialVersionName"><strong>Initial version</strong></label><input id="initialVersionName" name="initialVersionName" value="Initial Planning" maxlength="100" required /></p>
            <p><label for="description">Description</label><textarea id="description" name="description" rows="3" maxlength="1000"></textarea></p>
            <p><label><input name="createMonthlyPeriods" type="checkbox" value="true" checked style="width:auto" /> Generate monthly fiscal periods</label></p>
            <p><label><input name="isCurrent" type="checkbox" value="true" style="width:auto" /> Make this the current fiscal year</label></p>
            <button class="primary" type="submit">Create fiscal year</button>
        </form>
    </aside>
</div>
