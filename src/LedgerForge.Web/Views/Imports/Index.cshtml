@model LedgerForge.Web.Models.Imports.ImportPreviewViewModel
@{
    ViewData["Title"] = "Imports & Exports";
}
<section class="lf-card" aria-labelledby="import-title">
    <h1 id="import-title" class="lf-page-title">Legacy budget workbook preview</h1>
    <p class="lf-subtitle">Upload a compatible Excel workbook. LedgerForge validates the workbook structure, recalculates planned totals from quantity × unit cost, resolves managed lookup values, and stores a preview before any authoritative budget records are committed.</p>
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div role="alert" class="lf-alert lf-alert-danger"><strong>Upload could not be previewed.</strong><br />@Model.ErrorMessage</div>
    }
    <form method="post" action="/imports/legacy-budget/preview" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="lf-form-field"><label for="workbook"><strong>Excel workbook</strong></label><input id="workbook" name="workbook" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required /></div>
        <button type="submit" class="primary">Generate import preview</button>
    </form>
</section>
@if (Model.Result is not null)
{
    <section class="lf-card" aria-labelledby="preview-title" style="margin-top:1rem">
        <h2 id="preview-title">Preview result</h2>
        <table class="lf-table"><tbody>
            <tr><th>Import batch</th><td><code>@Model.Result.ImportBatchId</code></td></tr>
            <tr><th>Status</th><td>@Model.Result.Status</td></tr>
            <tr><th>Source rows</th><td>@Model.Result.SourceRowCount</td></tr>
            <tr><th>Accepted rows</th><td>@Model.Result.AcceptedRowCount</td></tr>
            <tr><th>Rejected rows</th><td>@Model.Result.RejectedRowCount</td></tr>
            <tr><th>Warnings</th><td>@Model.Result.WarningCount</td></tr>
            <tr><th>Errors</th><td>@Model.Result.ErrorCount</td></tr>
            <tr><th>Configured reconciliation expectation</th><td>@(Model.Result.ReconciledToExpectedTargets ? "Matches" : "Requires review")</td></tr>
        </tbody></table>
        <p class="lf-muted">Preview creates import/audit records only. It does not commit budget lines to authoritative tables.</p>
    </section>
}
