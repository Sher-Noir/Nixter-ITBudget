@model LedgerForge.Web.Models.Imports.ImportIndexViewModel
@{
    ViewData["Title"] = "Imports";
    var canManage = ViewData["CanManageImports"] as bool? == true;
}

<div class="lf-page-header">
    <div>
        <h1 class="lf-page-title">Imports</h1>
        <p class="lf-subtitle">Review import history and source lineage. Users with Manage access can create, review, accept, and commit import batches.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div role="alert" class="lf-card lf-alert lf-alert-danger"><strong>Upload could not be previewed.</strong><br />@Model.ErrorMessage</div>
}

@if (canManage)
{
    <div class="lf-settings-grid">
        <section class="lf-card" aria-labelledby="upload-title">
            <h2 id="upload-title">Create import preview</h2>
            <p class="lf-muted">The reference adapter accepts a compatible `.xlsx` workbook, validates its structure, recalculates planned totals server-side, resolves managed lookups, and stores an auditable preview.</p>
            <form method="post" action="/imports/legacy-budget/preview" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="lf-form-field">
                    <label for="workbook"><strong>Excel workbook</strong></label>
                    <input id="workbook" name="workbook" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required />
                </div>
                <button type="submit" class="primary">Generate import preview</button>
            </form>
        </section>

        <aside class="lf-card" aria-labelledby="import-guidance-title">
            <h2 id="import-guidance-title">Review gates</h2>
            <ul>
                <li>Open error exceptions must be resolved before acceptance.</li>
                <li>Rejected source rows require a written acceptance reason.</li>
                <li>Configured reconciliation mismatches require explicit administrator acceptance.</li>
                <li>Preview acceptance does not yet write authoritative budget records.</li>
            </ul>
        </aside>
    </div>
}

<section class="lf-card" aria-labelledby="batch-history-title">
    <div class="lf-panel-header">
        <div>
            <h2 id="batch-history-title">Import batch history</h2>
            <p class="lf-muted">Most recent preview, validation, acceptance, rejection, and commit records.</p>
        </div>
        <span class="badge">@Model.Batches.Count batch@(Model.Batches.Count == 1 ? string.Empty : "es")</span>
    </div>

    @if (Model.Batches.Count == 0)
    {
        <div class="lf-empty-state"><p>No import batches have been created yet.</p></div>
    }
    else
    {
        <div class="lf-table-wrap">
            <table class="lf-table">
                <thead>
                    <tr>
                        <th>Created</th>
                        <th>Source</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Rows</th>
                        <th>Exceptions</th>
                        <th class="lf-number">Planned Total</th>
                        <th>Reconciliation</th>
                        <th>Accepted By</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var batch in Model.Batches)
                {
                    <tr>
                        <td><a href="/imports/@batch.Id">@batch.CreatedAtUtc.ToString("u")</a></td>
                        <td><strong>@batch.SourceFileName</strong><br /><span class="lf-muted"><code>@batch.SourceSha256[..Math.Min(12, batch.SourceSha256.Length)]</code></span></td>
                        <td>@batch.ImportType</td>
                        <td><span class="badge">@batch.Status</span></td>
                        <td>@(batch.SourceRowCount?.ToString() ?? "—")</td>
                        <td>@(batch.ExceptionCount?.ToString() ?? "—")</td>
                        <td class="lf-number">@(batch.RecalculatedPlannedTotal?.ToString("C2") ?? "—")</td>
                        <td>@(batch.ReconciledToExpectedTargets is null ? "Not evaluated" : batch.ReconciledToExpectedTargets == true ? "Matches" : "Review")</td>
                        <td>@(batch.AcceptedBy ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>