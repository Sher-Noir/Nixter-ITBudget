@model LedgerForge.Infrastructure.Approvals.ApprovalQueueSnapshot
@using LedgerForge.Infrastructure.Approvals
@{
    ViewData["Title"] = "Approvals";
    var errorMessage = ViewData["ErrorMessage"] as string;
    var saved = ViewData["Saved"] as bool? == true;
}

<div class="lf-page-header">
    <div>
        <h1 class="lf-page-title">Approval Queue</h1>
        <p class="lf-subtitle">Review budget items, purchase orders, invoices, and budget amendments from one auditable queue.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="lf-card lf-alert lf-alert-danger" role="alert">@errorMessage</div>
}
@if (saved)
{
    <div class="lf-card lf-alert lf-alert-success" role="status">Approval decision saved.</div>
}

<div class="lf-kpi-grid">
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon blue">B</div><div><div class="lf-card-title">Budget Items</div><div class="lf-kpi-value">@Model.BudgetItemCount</div><div class="lf-kpi-note">Submitted planning items</div></div></article>
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon orange">PO</div><div><div class="lf-card-title">Purchase Orders</div><div class="lf-kpi-value">@Model.PurchaseOrderCount</div><div class="lf-kpi-note">Pending procurement approvals</div></div></article>
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon teal">I</div><div><div class="lf-card-title">Invoices</div><div class="lf-kpi-value">@Model.InvoiceCount</div><div class="lf-kpi-note">Pending invoice approvals</div></div></article>
    <article class="lf-card lf-kpi"><div class="lf-kpi-icon gold">A</div><div><div class="lf-card-title">Amendments</div><div class="lf-kpi-value">@Model.BudgetAmendmentCount</div><div class="lf-kpi-note">Pending budget changes</div></div></article>
</div>

<section class="lf-card" aria-labelledby="approval-list-title">
    <div class="lf-panel-header">
        <div><h2 id="approval-list-title">Pending decisions</h2><p class="lf-muted">Oldest submissions appear first · @Model.PendingAmount.ToString("C2") total financial impact.</p></div>
        <span class="badge">@Model.TotalCount pending</span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="lf-empty-state"><h2>Approval queue is clear</h2><p>No financial workflow is currently awaiting an approval decision.</p></div>
    }
    else
    {
        <div class="lf-admin-stack">
            @foreach (var item in Model.Items)
            {
                var typeLabel = item.Type switch
                {
                    ApprovalQueueItemType.BudgetItem => "Budget item",
                    ApprovalQueueItemType.PurchaseOrder => "Purchase order",
                    ApprovalQueueItemType.Invoice => "Invoice",
                    ApprovalQueueItemType.BudgetAmendment => "Budget amendment",
                    _ => item.Type.ToString()
                };
                <article class="lf-card lf-approval-card">
                    <div class="lf-panel-header">
                        <div>
                            <span class="badge">@typeLabel</span>
                            <h2>@item.Reference · @item.Description</h2>
                            <p class="lf-muted">@item.FiscalYear · submitted by @(item.SubmittedBy ?? "Unknown") @(item.SubmittedAtUtc is null ? string.Empty : $"on {item.SubmittedAtUtc.Value:u}")</p>
                        </div>
                        <strong class="lf-approval-amount">@item.Amount.ToString("C2")</strong>
                    </div>

                    <div class="lf-toolbar">
                        @switch (item.Type)
                        {
                            case ApprovalQueueItemType.BudgetItem:
                                <a class="button" href="/budget/items/@item.Id">Review item</a>
                                <form method="post" action="/approvals/budget-items/@item.Id/approve">
                                    @Html.AntiForgeryToken()
                                    <input name="note" maxlength="2000" placeholder="Optional approval note" />
                                    <button class="primary" type="submit">Approve</button>
                                </form>
                                <details>
                                    <summary>Deny or defer</summary>
                                    <div class="lf-approval-decision-grid">
                                        <form method="post" action="/approvals/budget-items/@item.Id/deny">
                                            @Html.AntiForgeryToken()
                                            <label for="deny-@item.Id">Denial reason</label>
                                            <input id="deny-@item.Id" name="reason" maxlength="2000" required />
                                            <button type="submit">Deny</button>
                                        </form>
                                        <form method="post" action="/approvals/budget-items/@item.Id/defer">
                                            @Html.AntiForgeryToken()
                                            <label for="defer-@item.Id">Deferral reason</label>
                                            <input id="defer-@item.Id" name="reason" maxlength="2000" required />
                                            <button type="submit">Defer</button>
                                        </form>
                                    </div>
                                </details>
                                break;
                            case ApprovalQueueItemType.PurchaseOrder:
                                <a class="button" href="/purchase-orders/@item.Id">Review purchase order</a>
                                <form method="post" action="/approvals/purchase-orders/@item.Id/approve">
                                    @Html.AntiForgeryToken()
                                    <button class="primary" type="submit">Approve</button>
                                </form>
                                <details><summary>Reject</summary><form method="post" action="/approvals/purchase-orders/@item.Id/reject">@Html.AntiForgeryToken()<label for="po-reject-@item.Id">Rejection reason</label><input id="po-reject-@item.Id" name="reason" maxlength="1000" required /><button type="submit">Reject</button></form></details>
                                break;
                            case ApprovalQueueItemType.Invoice:
                                <a class="button" href="/invoices/@item.Id">Review invoice</a>
                                <form method="post" action="/approvals/invoices/@item.Id/approve">
                                    @Html.AntiForgeryToken()
                                    <button class="primary" type="submit">Approve</button>
                                </form>
                                <details><summary>Reject</summary><form method="post" action="/approvals/invoices/@item.Id/reject">@Html.AntiForgeryToken()<label for="invoice-reject-@item.Id">Rejection reason</label><input id="invoice-reject-@item.Id" name="reason" maxlength="1000" required /><button type="submit">Reject</button></form></details>
                                break;
                            case ApprovalQueueItemType.BudgetAmendment:
                                <a class="button" href="/budget-amendments">Review amendments</a>
                                <form method="post" action="/approvals/budget-amendments/@item.Id/approve">
                                    @Html.AntiForgeryToken()
                                    <input name="note" maxlength="2000" placeholder="Optional approval note" />
                                    <button class="primary" type="submit">Approve</button>
                                </form>
                                <details><summary>Reject</summary><form method="post" action="/approvals/budget-amendments/@item.Id/reject">@Html.AntiForgeryToken()<label for="amendment-reject-@item.Id">Rejection reason</label><input id="amendment-reject-@item.Id" name="reason" maxlength="2000" required /><button type="submit">Reject</button></form></details>
                                break;
                        }
                    </div>
                </article>
            }
        </div>
    }
</section>
