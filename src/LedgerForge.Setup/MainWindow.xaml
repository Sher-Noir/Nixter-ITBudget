<Window x:Class="LedgerForge.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LedgerForge Setup" Height="760" Width="960" MinHeight="650" MinWidth="820"
        WindowStartupLocation="CenterScreen" Background="#F4F6F8">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#121923">
            <StackPanel Margin="28,34">
                <TextBlock Text="LEDGERFORGE" Foreground="White" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Setup Preview" Foreground="#9FB0C4" FontSize="14" Margin="0,6,0,26" />
                <TextBlock Text="1  Prerequisites" Foreground="White" FontSize="15" Margin="0,0,0,16" />
                <TextBlock Text="2  Configuration" Foreground="White" FontSize="15" Margin="0,0,0,16" />
                <TextBlock Text="3  Database" Foreground="White" FontSize="15" Margin="0,0,0,16" />
                <TextBlock Text="4  IIS deployment" Foreground="White" FontSize="15" Margin="0,0,0,16" />
                <TextBlock Text="5  Verification" Foreground="White" FontSize="15" />
                <Border Background="#1C2734" CornerRadius="8" Padding="14" Margin="0,30,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="#C5D0DC"
                               Text="This preview installer uses an existing local SQL Server/SQL Express instance and an installed ASP.NET Core Hosting Bundle. It does not silently install prerequisites." />
                </Border>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="30,24,30,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Install LedgerForge" FontSize="28" FontWeight="SemiBold" Foreground="#17202A" />
                <TextBlock Text="Configure a local Windows/IIS LedgerForge preview deployment." FontSize="14" Foreground="#5B6775" Margin="0,4,0,14" />
                <Border x:Name="PreflightBanner" Background="#FFF4CE" CornerRadius="7" Padding="12">
                    <TextBlock x:Name="PreflightText" Text="Run prerequisite checks before installing." TextWrapping="Wrap" Foreground="#594A00" />
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,18">
                <StackPanel>
                    <TextBlock Text="Organization name" FontWeight="SemiBold" />
                    <TextBox x:Name="OrganizationNameText" Text="Your Organization" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="IIS site / application pool name" FontWeight="SemiBold" />
                            <TextBox x:Name="SiteNameText" Text="LedgerForge" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="HTTP port" FontWeight="SemiBold" />
                            <TextBox x:Name="PortText" Text="8080" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Application install path" FontWeight="SemiBold" />
                    <TextBox x:Name="InstallPathText" />

                    <TextBlock Text="Document storage path (outside web root)" FontWeight="SemiBold" />
                    <TextBox x:Name="DocumentsPathText" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Local SQL Server instance" FontWeight="SemiBold" />
                            <TextBox x:Name="SqlServerText" Text=".\SQLEXPRESS" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Database name" FontWeight="SemiBold" />
                            <TextBox x:Name="DatabaseNameText" Text="LedgerForge" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Initial System Administrator identity" FontWeight="SemiBold" />
                    <TextBox x:Name="InitialAdminText" />
                    <TextBlock Text="The setup identity receives an explicit System Administrator grant so the first login cannot lock you out." Foreground="#66717E" FontSize="12" Margin="0,-5,0,10" TextWrapping="Wrap" />

                    <TextBlock Text="System Administrator AD group (optional)" FontWeight="SemiBold" />
                    <TextBox x:Name="AdminGroupText" />

                    <TextBlock Text="Installation log" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBox x:Name="LogText" Height="150" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="2" LastChildFill="False">
                <TextBlock x:Name="StatusText" Text="Ready." VerticalAlignment="Center" Foreground="#4D5966" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="CheckButton" Content="Check prerequisites" Click="CheckButton_Click" />
                    <Button x:Name="InstallButton" Content="Install preview" Click="InstallButton_Click" IsEnabled="False" />
                    <Button Content="Close" Click="CloseButton_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
